  frecuencia            RiesgosFrecuencia      @relation(fields: [codigoCia, codigoFrecuencia], references: [codigoCia, codigoFrecuencia], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_plan_responsable_frecuencia_fk")
