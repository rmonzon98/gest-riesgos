model RiesgosSolicitudEliminacion {
  codigoCia            Int                    @map("CODIGO_CIA")
  codigoSolicitud      Int                    @default(autoincrement()) @map("CODIGO_SOLICITUD")
  codigoEntidad        Int                    @map("CODIGO_ENTIDAD")
  codigoPeriodo        Int                    @map("CODIGO_PERIODO")
  codigoRiesgo         Int                    @map("CODIGO_RIESGO")
  motivo               String                 @map("MOTIVO") @db.VarChar(1000)
  codigoSolicitante    Int                    @map("CODIGO_SOLICITANTE")
  fechaSolicitud       DateTime               @map("FECHA_SOLICITUD") @db.DateTime(0)
  estado               String                 @default("P") @map("ESTADO") @db.Char(1)
  codigoResolutor      Int?                   @map("CODIGO_RESOLUTOR")
  /// Columna generada por MariaDB para limitar las solicitudes pendientes a una por riesgo.
  esPendiente          Int?                   @map("ES_PENDIENTE") @ignore
  fechaResolucion      DateTime?              @map("FECHA_RESOLUCION") @db.DateTime(0)
  comentarioResolucion String?                @map("COMENTARIO_RESOLUCION") @db.VarChar(1000)
  usuarioCreacion      Int?                   @map("USUARIO_CREACION")
  fechaCreacion        DateTime               @default(now()) @map("FECHA_CREACION") @db.DateTime(0)
  usuarioModificacion  Int?                   @map("USUARIO_MODIFICACION")
  fechaModificacion    DateTime?              @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgo               RiesgosRiesgoExtendido @relation(fields: [codigoCia, codigoEntidad, codigoPeriodo, codigoRiesgo], references: [codigoCia, codigoEntidad, codigoPeriodo, codigoRiesgo], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_solicitud_eliminacion_riesgo_fk")
  solicitante          SeguridadPersona       @relation("SolicitanteEliminacion", fields: [codigoCia, codigoSolicitante], references: [codigoCia, codigoColaborador], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_solicitud_eliminacion_solicitante_fk")
  resolutor            SeguridadPersona?      @relation("ResolutorEliminacion", fields: [codigoCia, codigoResolutor], references: [codigoCia, codigoColaborador], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_solicitud_eliminacion_resolutor_fk")

  @@id([codigoCia, codigoSolicitud])
  @@unique([codigoCia, codigoEntidad, codigoPeriodo, codigoRiesgo, esPendiente], map: "uq_solicitud_pendiente")
  @@index([codigoSolicitud], map: "riesgos_solicitud_eliminacion_ai_idx")
  @@index([codigoCia, codigoEntidad, codigoPeriodo, codigoRiesgo], map: "riesgos_solicitud_eliminacion_riesgo_idx")
  @@index([codigoCia, codigoSolicitante], map: "riesgos_solicitud_eliminacion_solicitante_idx")
  @@index([codigoCia, codigoResolutor], map: "riesgos_solicitud_eliminacion_resolutor_idx")
  @@map("riesgos_solicitud_eliminacion")
}

