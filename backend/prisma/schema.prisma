generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model RiesgosArea {
  codigoCia              Int                      @map("CODIGO_CIA")
  codigoArea             Int                      @map("CODIGO_AREA")
  descripcion            String                   @map("DESCRIPCION") @db.VarChar(200)
  abreviatura            String?                  @map("ABREVIATURA") @db.VarChar(10)
  estado                 String                   @default("1") @map("ESTADO") @db.VarChar(1)
  usuarioCreacion        Int?                     @map("USUARIO_CREACION")
  usuarioModificacion    Int?                     @map("USUARIO_MODIFICACION")
  fechaCreacion          DateTime?                @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion      DateTime?                @map("FECHA_MODIFICACION") @db.DateTime(0)
  seguridadInstitucion   SeguridadInstitucion     @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "riesgos_area_seguridad_institucion_FK")
  riesgosRiesgoExtendido RiesgosRiesgoExtendido[]
  codigoEntidad          Int?                     @map("CODIGO_ENTIDAD")
  direccion              SeguridadEntidad?        @relation(fields: [codigoCia, codigoEntidad], references: [codigoCia, codigoEntidad], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_area_direccion_fk")
  riesgosVinculados      RiesgosRiesgoVinculo[]

  @@id([codigoCia, codigoArea])
  @@index([codigoCia, codigoEntidad], map: "riesgos_area_direccion_idx")
  @@map("riesgos_area")
}

model RiesgosColaboradorSuperior {
  codigoCia           Int               @map("CODIGO_CIA")
  codigoColaborador   Int               @map("CODIGO_COLABORADOR")
  nombreSuperior      String?           @map("NOMBRE_SUPERIOR") @db.VarChar(100)
  puestoSuperior      String?           @map("PUESTO_SUPERIOR") @db.VarChar(100)
  usuarioCreacion     Int?              @map("USUARIO_CREACION")
  usuarioModificacion Int?              @map("USUARIO_MODIFICACION")
  fechaCreacion       DateTime?         @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion   DateTime?         @map("FECHA_MODIFICACION") @db.DateTime(0)
  seguridadPersona    SeguridadPersona  @relation("ColaboradorSuperiorPersona", fields: [codigoCia, codigoColaborador], references: [codigoCia, codigoColaborador], onUpdate: Restrict, map: "riesgos_colaborador_superior_seguridad_persona_FK")
  codigoSuperior      Int?              @map("CODIGO_SUPERIOR")
  superior            SeguridadPersona? @relation("ColaboradorSuperiorUsuario", fields: [codigoCia, codigoSuperior], references: [codigoCia, codigoColaborador], onDelete: Restrict, onUpdate: Restrict, map: "riesgos_colaborador_superior_superior_fk")

  @@id([codigoCia, codigoColaborador])
  @@index([codigoCia, codigoSuperior], map: "riesgos_colaborador_superior_superior_idx")
  @@map("riesgos_colaborador_superior")
}

model RiesgosDocumentos {
  codigoCia           Int              @map("CODIGO_CIA")
  codigoDocumento     Int              @map("CODIGO_DOCUMENTO")
  nombreReal          String?          @map("NOMBRE_REAL") @db.VarChar(250)
  path                String?          @map("PATH") @db.VarChar(400)
  tipo                String?          @map("TIPO") @db.VarChar(250)
  codigoPeriodo       Int?             @map("CODIGO_PERIODO")
  categoria           String?          @map("CATEGORIA") @db.VarChar(50)
  fechaCreacion       DateTime?        @map("FECHA_CREACION") @db.DateTime(0)
  final               Int?             @default(0) @map("FINAL")
  codigoEntidad       Int              @map("CODIGO_ENTIDAD")
  usuarioCreacion     Int?             @map("USUARIO_CREACION")
  usuarioModificacion Int?             @map("USUARIO_MODIFICACION")
  fechaModificacion   DateTime?        @map("FECHA_MODIFICACION") @db.DateTime(0)
  activo              Int?             @default(1) @map("ACTIVO")
  seguridadEntidad    SeguridadEntidad @relation(fields: [codigoCia, codigoEntidad], references: [codigoCia, codigoEntidad], onUpdate: Restrict, map: "riesgos_documentos_seguridad_entidad_FK")

  @@id([codigoCia, codigoEntidad, codigoDocumento])
  @@map("riesgos_documentos")
}

model RiesgosFrecuencia {
  codigoFrecuencia       Int                      @map("CODIGO_FRECUENCIA")
  descripcion            String?                  @map("DESCRIPCION") @db.VarChar(25)
  estado                 String                   @default("1") @map("ESTADO") @db.VarChar(1)
  codigoCia              Int                      @map("CODIGO_CIA")
  dias                   Int?                     @map("DIAS")
  usuarioCreacion        Int?                     @map("USUARIO_CREACION")
  fechaCreacion          DateTime?                @map("FECHA_CREACION") @db.DateTime(0)
  usuarioModificacion    Int?                     @map("USUARIO_MODIFICACION")
  fechaModificacion      DateTime?                @map("FECHA_MODIFICACION") @db.DateTime(0)
  seguridadInstitucion   SeguridadInstitucion     @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "riesgos_frecuencia_seguridad_institucion_FK")
  riesgosRiesgoExtendido RiesgosRiesgoExtendido[]
  cortesAnio             Int?                     @map("CORTES_ANIO")
  responsablesPlan       RiesgosPlanResponsable[]

  @@id([codigoCia, codigoFrecuencia])
  @@map("riesgos_frecuencia")
}

model RiesgosInformeAnual {
  codigoCia           Int            @map("CODIGO_CIA")
  codigoPeriodo       Int            @map("CODIGO_PERIODO")
  informacion         String?        @map("INFORMACION") @db.LongText
  fechaCreacion       DateTime?      @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion   DateTime?      @map("FECHA_MODIFICACION") @db.DateTime(0)
  usuarioCreacion     Int?           @map("USUARIO_CREACION")
  usuarioModificacion Int?           @map("USUARIO_MODIFICACION")
  riesgosPeriodo      RiesgosPeriodo @relation(fields: [codigoCia, codigoPeriodo], references: [codigoCia, codigoPeriodo], onUpdate: Restrict, map: "riesgos_informe_anual_riesgos_periodo_FK")

  @@id([codigoCia, codigoPeriodo])
  @@map("riesgos_informe_anual")
}

model RiesgosLogs {
  codigoCia            Int                  @map("CODIGO_CIA")
  codigoLog            Int                  @map("CODIGO_LOG")
  usuarioCreacion      Int?                 @map("USUARIO_CREACION")
  fechaCreacion        DateTime?            @map("FECHA_CREACION") @db.DateTime(0)
  nombreTabla          String?              @map("NOMBRE_TABLA") @db.VarChar(100)
  accion               Int?                 @map("ACCION")
  informacion          String?              @map("INFORMACION") @db.LongText
  seguridadInstitucion SeguridadInstitucion @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "logs_seguridad_institucion_FK")

  @@id([codigoCia, codigoLog])
  @@index([nombreTabla], map: "riesgos_logs_NOMBRE_TABLA_IDX")
  @@map("riesgos_logs")
}

model RiesgosMatrizInsti {
  codigoCia            Int                  @map("CODIGO_CIA")
  codigoPeriodo        Int                  @map("CODIGO_PERIODO")
  tipo                 Int                  @map("TIPO")
  version              Int                  @map("VERSION")
  respuesta            String?              @map("RESPUESTA") @db.LongText
  usuarioCreacion      Int?                 @map("USUARIO_CREACION")
  fechaCreacion        DateTime?            @map("FECHA_CREACION") @db.DateTime(0)
  riesgosPeriodo       RiesgosPeriodo       @relation(fields: [codigoCia, codigoPeriodo], references: [codigoCia, codigoPeriodo], onUpdate: Restrict, map: "RMI_RPE_FK")
  seguridadInstitucion SeguridadInstitucion @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "riesgos_matriz_insti_seguridad_institucion_FK")

  @@id([codigoCia, codigoPeriodo, tipo, version])
  @@map("riesgos_matriz_insti")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model RiesgosMitigacion {
  codigoMitigacion       Int                      @id @map("CODIGO_MITIGACION")
  descripcion            String?                  @map("DESCRIPCION") @db.VarChar(25)
  nombreExtra            String?                  @map("NOMBRE_EXTRA") @db.VarChar(50)
  valor                  Int?                     @map("VALOR")
  usuarioCreacion        Int?                     @map("USUARIO_CREACION")
  usuarioModificacion    Int?                     @map("USUARIO_MODIFICACION")
  fechaCreacion          DateTime?                @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion      DateTime?                @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgosRiesgoExtendido RiesgosRiesgoExtendido[] @relation("MitigacionRiesgo")
  riesgosPorEficiencia   RiesgosRiesgoExtendido[] @relation("EficienciaMitigador")

  @@map("riesgos_mitigacion")
}

model RiesgosObjetivo {
  codigoCia              Int                      @map("CODIGO_CIA")
  codigoTipoObjetivo     String                   @map("CODIGO_TIPO_OBJETIVO") @db.VarChar(3)
  codigoObjetivo         Int                      @map("CODIGO_OBJETIVO")
  descripcion            String?                  @map("DESCRIPCION") @db.VarChar(800)
  abreviatura            String?                  @map("ABREVIATURA") @db.VarChar(10)
  estado                 String                   @default("1") @map("ESTADO") @db.VarChar(1)
  usuarioCreacion        Int?                     @map("USUARIO_CREACION")
  usuarioModificacion    Int?                     @map("USUARIO_MODIFICACION")
  fechaCreacion          DateTime?                @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion      DateTime?                @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgosTipoObjetivo    RiesgosTipoObjetivo      @relation(fields: [codigoCia, codigoTipoObjetivo], references: [codigoCia, codigoTipoObjetivo], onUpdate: Restrict, map: "FK_TIPO_OBJETIVO_OBJETIVO")
  riesgosRiesgoExtendido RiesgosRiesgoExtendido[]

  @@id([codigoCia, codigoTipoObjetivo, codigoObjetivo])
  @@map("riesgos_objetivo")
}

model RiesgosOrganos {
  codigoCia            Int                  @map("CODIGO_CIA")
  codigoOrgano         Int                  @map("CODIGO_ORGANO")
  nombre               String?              @map("NOMBRE") @db.VarChar(100)
  usuarioCreacion      Int?                 @map("USUARIO_CREACION")
  fechaCreacion        DateTime?            @map("FECHA_CREACION") @db.DateTime(0)
  usuarioModificacion  Int?                 @map("USUARIO_MODIFICACION")
  fechaModificacion    DateTime?            @map("FECHA_MODIFICACION") @db.DateTime(0)
  seguridadInstitucion SeguridadInstitucion @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "riesgos_organos_seguridad_institucion_FK")

  @@id([codigoCia, codigoOrgano])
  @@map("riesgos_organos")
}

model RiesgosPeriodo {
  codigoCia                         Int                                 @map("CODIGO_CIA")
  codigoPeriodo                     Int                                 @map("CODIGO_PERIODO")
  periodoInicial                    DateTime?                           @map("PERIODO_INICIAL") @db.DateTime(0)
  periodoFinal                      DateTime?                           @map("PERIODO_FINAL") @db.DateTime(0)
  activo                            Int?                                @default(1) @map("ACTIVO") @db.TinyInt
  usuarioCreacion                   Int                                 @map("USUARIO_CREACION")
  usuarioModificacion               Int?                                @map("USUARIO_MODIFICACION")
  fechaCreacion                     DateTime                            @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion                 DateTime?                           @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgosInformeAnual               RiesgosInformeAnual?
  riesgosMatrizInsti                RiesgosMatrizInsti[]
  seguridadInstitucion              SeguridadInstitucion                @relation(fields: [codigoCia], references: [codigoCia], onUpdate: Restrict, map: "riesgos_periodo_seguridad_institucion_FK")
  riesgosPrimeraMatriz              RiesgosPrimeraMatriz[]
  riesgosPrimeraMatrizHis           RiesgosPrimeraMatrizHis[]
  riesgosReportesPropiedades        RiesgosReportesPropiedades[]
  riesgosRiesgoExtendido            RiesgosRiesgoExtendido[]
  riesgosRiesgoPropiedadesVersiones RiesgosRiesgoPropiedadesVersiones[]
  riesgosSeguimiento                RiesgosSeguimiento[]
  riesgosSeguimientoReporte         RiesgosSeguimientoReporte[]
  riesgosSegundaMatriz              RiesgosSegundaMatriz[]
  riesgosSegundaMatrizHis           RiesgosSegundaMatrizHis[]

  @@id([codigoCia, codigoPeriodo])
  @@map("riesgos_periodo")
}

model RiesgosPrimeraMatriz {
  codigoCia               Int                       @map("CODIGO_CIA")
  codigoPeriodo           Int                       @map("CODIGO_PERIODO")
  version                 Int                       @map("VERSION")
  usuarioCreacion         Int?                      @map("USUARIO_CREACION")
  fechaCreacion           DateTime?                 @map("FECHA_CREACION") @db.DateTime(0)
  estado                  String?                   @map("ESTADO") @db.VarChar(1)
  usuarioModificacion     Int?                      @map("USUARIO_MODIFICACION")
  fechaModificacion       DateTime?                 @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgosPeriodo          RiesgosPeriodo            @relation(fields: [codigoCia, codigoPeriodo], references: [codigoCia, codigoPeriodo], onUpdate: Restrict, map: "RPMA_RPER_FK")
  riesgosPrimeraMatrizEst RiesgosPrimeraMatrizEst[]

  @@id([codigoCia, codigoPeriodo, version])
  @@map("riesgos_primera_matriz")
}

model RiesgosPrimeraMatrizEst {
  codigoCia            Int                  @map("CODIGO_CIA")
  codigoPeriodo        Int                  @map("CODIGO_PERIODO")
  version              Int                  @map("VERSION")
  matriz               Int                  @map("MATRIZ")
  titulo               String?              @map("TITULO") @db.VarChar(250)
  columnas             String?              @map("COLUMNAS") @db.LongText
  filas                String?              @map("FILAS") @db.LongText
  obligatorio          String?              @map("OBLIGATORIO") @db.LongText
  riesgosPrimeraMatriz RiesgosPrimeraMatriz @relation(fields: [codigoCia, codigoPeriodo, version], references: [codigoCia, codigoPeriodo, version], onUpdate: Restrict, map: "riesgos_primera_matriz_est_riesgos_primera_matriz_FK")

  @@id([codigoCia, codigoPeriodo, version, matriz])
  @@map("riesgos_primera_matriz_est")
}

model RiesgosPrimeraMatrizHis {
  codigoCia            Int              @map("CODIGO_CIA")
  codigoEntidad        Int              @map("CODIGO_ENTIDAD")
  codigoPeriodo        Int              @map("CODIGO_PERIODO")
  codigoHistorial      Int              @map("CODIGO_HISTORIAL")
  respuesta            String?          @map("RESPUESTA") @db.LongText
  comentarioSupervisor String?          @map("COMENTARIO_SUPERVISOR") @db.VarChar(500)
  usuarioCreacion      Int?             @map("USUARIO_CREACION")
  fechaCreacion        DateTime?        @map("FECHA_CREACION") @db.DateTime(0)
  estado               String?          @default("I") @map("ESTADO") @db.VarChar(1)
  fechaModificacion    DateTime?        @map("FECHA_MODIFICACION") @db.DateTime(0)
  usuarioModificacion  Int?             @map("USUARIO_MODIFICACION")
  version              Int?             @map("VERSION")
  estadoSuperior       String?          @default("I") @map("ESTADO_SUPERIOR") @db.VarChar(1)
  comentarioSuperior   String?          @map("COMENTARIO_SUPERIOR") @db.VarChar(500)
  usuarioSuperior      Int?             @map("USUARIO_SUPERIOR")
  fechaSuperior        DateTime?        @map("FECHA_SUPERIOR") @db.DateTime(0)
  riesgosPeriodo       RiesgosPeriodo   @relation(fields: [codigoCia, codigoPeriodo], references: [codigoCia, codigoPeriodo], onUpdate: Restrict, map: "riesgos_primera_matriz_his_riesgos_periodo_FK")
  seguridadEntidad     SeguridadEntidad @relation(fields: [codigoCia, codigoEntidad], references: [codigoCia, codigoEntidad], onUpdate: Restrict, map: "riesgos_primera_matriz_his_seguridad_entidad_FK")

  @@id([codigoCia, codigoEntidad, codigoPeriodo, codigoHistorial])
  @@index([codigoCia, codigoPeriodo], map: "riesgos_primera_matriz_his_riesgos_periodo_FK")
  @@map("riesgos_primera_matriz_his")
}

model RiesgosProbabilidad {
  codigoProbabilidad     Int                      @id @map("CODIGO_PROBABILIDAD")
  descripcion            String?                  @map("DESCRIPCION") @db.VarChar(25)
  usuarioCreacion        Int?                     @map("USUARIO_CREACION")
  usuarioModificacion    Int?                     @map("USUARIO_MODIFICACION")
  fechaCreacion          DateTime?                @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion      DateTime?                @map("FECHA_MODIFICACION") @db.DateTime(0)
  riesgosRiesgoExtendido RiesgosRiesgoExtendido[]

  @@map("riesgos_probabilidad")
}

model RiesgosReportesPropiedades {
  codigoCia       Int            @map("CODIGO_CIA")
  codigoPeriodo   Int            @map("CODIGO_PERIODO")
  codigoVersion   Int            @map("CODIGO_VERSION")
  propiedadesMe   String?        @map("PROPIEDADES_ME") @db.LongText
  defecto         String?        @default("S") @map("DEFECTO") @db.VarChar(1)
  usuarioCreacion Int?           @map("USUARIO_CREACION")
  fechaCreacion   DateTime?      @map("FECHA_CREACION") @db.DateTime(0)
  propiedadesMc   String?        @map("PROPIEDADES_MC") @db.LongText
  propiedadesMce  String?        @map("PROPIEDADES_MCE") @db.LongText
  riesgosPeriodo  RiesgosPeriodo @relation(fields: [codigoCia, codigoPeriodo], references: [codigoCia, codigoPeriodo], onUpdate: Restrict, map: "riesgos_reportes_propiedades_riesgos_periodo_FK")

  @@id([codigoCia, codigoPeriodo, codigoVersion])
  @@map("riesgos_reportes_propiedades")
}

model RiesgosRiesgoExtendido {
  codigoCia                 Int                           @map("CODIGO_CIA")
  codigoEntidad             Int                           @map("CODIGO_ENTIDAD")
  codigoPeriodo             Int                           @map("CODIGO_PERIODO")
  codigoRiesgo              Int                           @map("CODIGO_RIESGO")
  periodoAnterior           Int?                          @map("PERIODO_ANTERIOR")
  esNuevo                   Boolean                       @default(false) @map("ES_NUEVO")
  eliminado                 Int?                          @default(0) @map("ELIMINADO")
  descripcion               String?                       @map("DESCRIPCION") @db.VarChar(1000)
  codigoTipoObjetivo        String?                       @map("CODIGO_TIPO_OBJETIVO") @db.VarChar(3)
  codigoObjetivo            Int?                          @map("CODIGO_OBJETIVO")
  codigoArea                Int?                          @map("CODIGO_AREA")
  ref                       String?                       @map("REF") @db.VarChar(35)
  codigoProbabilidad        Int?                          @map("CODIGO_PROBABILIDAD")
  codigoSeveridad           Int?                          @map("CODIGO_SEVERIDAD")
  codigoTolerancia          Int?                          @map("CODIGO_TOLERANCIA")
  codigoMitigacion          Int?                          @map("CODIGO_MITIGACION")
  observaciones             String?                       @map("OBSERVACIONES") @db.VarChar(1000)
  variableMitigacion        String?                       @map("VARIABLE_MITIGACION") @db.VarChar(1)
  usuarioCreacion           Int?                          @map("USUARIO_CREACION")
  usuarioModificacion       Int?                          @map("USUARIO_MODIFICACION")
  fechaCreacion             DateTime?                     @map("FECHA_CREACION") @db.DateTime(0)
  fechaModificacion         DateTime?                     @map("FECHA_MODIFICACION") @db.DateTime(0)
  comentarioSupervisorMe    String?                       @map("COMENTARIO_SUPERVISOR_ME") @db.VarChar(500)
  supervisorModificacionMe  Int?                          @map("SUPERVISOR_MODIFICACION_ME")
  fechaSupervisorMe         DateTime?                     @map("FECHA_SUPERVISOR_ME") @db.DateTime(0)
  mostrarGeneral            String?                       @default("N") @map("MOSTRAR_GENERAL") @db.VarChar(1)
  severidadNarracion        String?                       @map("SEVERIDAD_NARRACION") @db.VarChar(500)
  probabilidadAjustada      Int?                          @map("PROBABILIDAD_AJUSTADA")
  severidadAjustada         Int?                          @map("SEVERIDAD_AJUSTADA")
  riesgoResidual            Int?                          @map("RIESGO_RESIDUAL")
  riesgoInherente           Int?                          @map("RIESGO_INHERENTE")
  evento                    String?                       @map("EVENTO") @db.LongText
  control                   String?                       @map("CONTROL") @db.VarChar(1000)
  monitoreo                 String?                       @map("MONITOREO") @db.VarChar(750)
  codigoFrecuencia          Int?                          @map("CODIGO_FRECUENCIA")
  responsable               String?                       @map("RESPONSABLE") @db.VarChar(250)
  extrasMc                  String?                       @map("EXTRAS_MC") @db.LongText
  estadoMe                  Int?                          @default(0) @map("ESTADO_ME")
  extrasMe                  String?                       @map("EXTRAS_ME") @db.LongText
  extrasMce                 String?                       @map("EXTRAS_MCE") @db.LongText
  estadoMc                  Int?                          @default(0) @map("ESTADO_MC")
  estadoMce                 Int?                          @default(0) @map("ESTADO_MCE")
  fechaSupervisorMc         DateTime?                     @map("FECHA_SUPERVISOR_MC") @db.DateTime(0)
  fechaSupervisorMce        DateTime?                     @map("FECHA_SUPERVISOR_MCE") @db.DateTime(0)
  supervisorModificacionMc  Int?                          @map("SUPERVISOR_MODIFICACION_MC")
  supervisorModificacionMce Int?                          @map("SUPERVISOR_MODIFICACION_MCE")
  comentarioSupervisorMc    String?                       @map("COMENTARIO_SUPERVISOR_MC") @db.VarChar(500)
  comentarioSupervisorMce   String?                       @map("COMENTARIO_SUPERVISOR_MCE") @db.VarChar(500)
  viceministerio            Int?                          @map("VICEMINISTERIO")
  organo                    Int?                          @map("ORGANO")
  estadoMeSuperior          Int?                          @default(0) @map("ESTADO_ME_SUPERIOR")
  comentarioSuperiorMe      String?                       @map("COMENTARIO_SUPERIOR_ME") @db.VarChar(500)
  superiorModificacionMe    Int?                          @map("SUPERIOR_MODIFICACION_ME")
  fechaSuperiorMe           DateTime?                     @map("FECHA_SUPERIOR_ME") @db.DateTime(0)
  estadoMcSuperior          Int?                          @default(0) @map("ESTADO_MC_SUPERIOR")
  superiorModificacionMc    Int?                          @map("SUPERIOR_MODIFICACION_MC")
  comentarioSuperiorMc      String?                       @map("COMENTARIO_SUPERIOR_MC") @db.VarChar(500)
  fechaSuperiorMc           DateTime?                     @map("FECHA_SUPERIOR_MC") @db.DateTime(0)
  estadoMceSuperior         Int?                          @default(0) @map("ESTADO_MCE_SUPERIOR")
  superiorModificacionMce   String?                       @map("SUPERIOR_MODIFICACION_MCE") @db.VarChar(100)
  comentarioSuperiorMce     String?                       @map("COMENTARIO_SUPERIOR_MCE") @db.VarChar(500)
  fechaSuperiorMce          DateTime?                     @map("FECHA_SUPERIOR_MCE") @db.DateTime(0)
  riesgosArea               RiesgosArea?                  @relation(fields: [codigoCia, codigoArea], references: [codigoCia, codigoArea], onUpdate: Restrict, map: "riesgos_riesgo_extendido_riesgos_area_FK")
