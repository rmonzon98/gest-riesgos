SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false/true 
SMTP_USER=correo@notificaciones.com
SMTP_PASS="mypassword"
MAIL_FROM="correo@notificaciones.com"

CORS_URL = http://localhost:3000 #<dominio> o http://localhost:3000
SECRET_KEY = change_me
SERVER_PORT = 3001

#CREDENCIALES MYSQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD='root'
#DB_NAME= gestion_riesgos
DB_PORT=3307
# Prisma/MariaDB. Si se omite, el backend la arma desde DB_HOST, DB_USER, DB_PASSWORD, DB_PORT y DB_NAME.
#DATABASE_URL="mysql://root:root@localhost:3307/gestion_riesgos"


#Las nuevas variables del .env serían estas:
# Duración del token temporal de 2FA, en minutos
TWO_FACTOR_TOKEN_MINUTES=30

# JWT / cookies
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
TWO_FACTOR_TOKEN_MINUTES=5

# Cookies
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

# TOTP
# Llave para cifrar secretos TOTP en BD.
# Debe ser de 32 bytes en base64.
# Para generar una llave de ejemplo, puedes usar el siguiente comando en la terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=change_me

# Nombre que aparecerá en Google Authenticator / Microsoft Authenticator
TOTP_ISSUER=SIGERI
